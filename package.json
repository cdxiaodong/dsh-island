{
  "name": "dsh-island",
  "version": "0.5.9",
  "description": "自带 macOS 菜单栏灵动岛的 DSH 插件 — 鲸鱼娘桌宠 + DSH 浅蓝胶囊托盘（blue-fantasy 配色），实时显示会话/工具/审批，点击展开可直接批准/拒绝",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "bin",
    "panel",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "codeisland",
    "notch",
    "dynamic-island",
    "agent",
    "status",
    "realtime"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mjs\"",
    "demo": "node scripts/demo.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "cordis": "^4.0.0-rc.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
